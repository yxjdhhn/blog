---
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';
import TableOfContents from '@/components/TableOfContents.astro';
import Comments from '@/components/Comments.astro';
import { formatDate } from '@/utils/date';
import { getLangFromUrl, t, getLocalizedUrl } from '@/i18n/utils';
import { estimateReadingTime } from '@/i18n/utils';
import type { BlogPost } from '@/utils/posts';

interface Props {
  post: BlogPost;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const readingTime = estimateReadingTime(post.body || '');
---

<BaseLayout title={`${post.data.title} | ${t(lang, 'site.title')}`} description={post.data.description} image={post.data.heroImage}>
  <article class="max-w-6xl xl:max-w-7xl 2xl:max-w-[88rem] mx-auto px-4 sm:px-6 py-8">
    <div class="flex justify-center xl:gap-16 2xl:gap-24">
      {headings.length > 0 && (
        <aside class="hidden xl:block w-52 shrink-0">
          <div class="sticky top-24">
            <TableOfContents headings={headings} />
          </div>
        </aside>
      )}

      <div class="w-full max-w-3xl min-w-0">
        <!-- Article header -->
        <header class="max-w-3xl mx-auto mb-8">
          {post.data.heroImage && (
            <div class="relative mb-8 w-full overflow-hidden rounded-xl border border-border bg-bg-subtle shadow-lg aspect-[3/2] md:aspect-[16/9]">
              <Image
                src={post.data.heroImage}
                alt={post.data.title}
                class="relative z-10 h-full w-full object-cover"
                loading="eager"
                sizes="(min-width: 1024px) 896px, 100vw"
                fit="cover"
                position="center"
              />
            </div>
          )}

          <div class="flex items-center gap-2 text-sm text-muted mb-4">
            <time datetime={post.data.pubDate.toISOString()}>
              {t(lang, 'post.published')} {formatDate(post.data.pubDate, lang)}
            </time>
            {post.data.updatedDate && (
              <>
                <span>&middot;</span>
                <time datetime={post.data.updatedDate.toISOString()}>
                  {t(lang, 'post.updated')} {formatDate(post.data.updatedDate, lang)}
                </time>
              </>
            )}
            <span>&middot;</span>
            <span>{readingTime} {t(lang, 'post.minRead')}</span>
          </div>

          <h1 class="text-3xl sm:text-4xl font-bold text-heading mb-4 leading-tight">
            {post.data.title}
          </h1>

          <p class="text-lg text-secondary mb-4">
            {post.data.description}
          </p>

          <div class="flex flex-wrap items-center gap-2">
            {post.data.category && (
              <a
                href={getLocalizedUrl(lang, `/categories/${post.data.category}/`)}
                class="text-xs px-3 py-1 rounded-full bg-primary-bg-hover text-primary-hover font-medium hover:bg-primary-bg-strong transition-colors"
              >
                {post.data.category}
              </a>
            )}
            {post.data.tags.map((tag) => (
              <a
                href={getLocalizedUrl(lang, `/tags/${tag}/`)}
                class="text-xs px-2.5 py-0.5 rounded-full bg-bg-subtle text-secondary hover:bg-primary-bg-hover hover:text-primary-hover transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        </header>

        <!-- Article content -->
        <div class="prose max-w-none" data-pagefind-body>
          <slot />
        </div>

        <button
          type="button"
          class="control-button fixed right-4 bottom-[calc(1rem+env(safe-area-inset-bottom))] z-40 translate-y-4 pointer-events-none opacity-0 transition-all duration-200 sm:right-6 sm:bottom-[calc(1.5rem+env(safe-area-inset-bottom))]"
          data-back-to-top
          aria-hidden="true"
          tabIndex={-1}
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 19V5" />
            <path d="m6.75 10.25 5.25-5.25 5.25 5.25" />
          </svg>
        </button>

        <script>
          const initCollapsibleCode = () => {
            document.querySelectorAll('.collapsible-code-details').forEach((details) => {
              const summary = details.querySelector('.collapsible-code-summary');
              if (!summary) return;
              const expand = summary.getAttribute('data-expand') || '展开代码';
              const collapse = summary.getAttribute('data-collapse') || '折叠代码';
              const update = () => { summary.textContent = details.open ? collapse : expand; };
              details.addEventListener('toggle', update);
              update();
            });
          };

          const initBackToTop = () => {
            const button = document.querySelector('[data-back-to-top]');
            const articleContent = document.querySelector('[data-pagefind-body]');
            if (!(button instanceof HTMLButtonElement) || !(articleContent instanceof HTMLElement)) return;

            const setVisible = (visible) => {
              button.classList.toggle('translate-y-0', visible);
              button.classList.toggle('opacity-100', visible);
              button.classList.toggle('pointer-events-auto', visible);
              button.classList.toggle('translate-y-4', !visible);
              button.classList.toggle('opacity-0', !visible);
              button.classList.toggle('pointer-events-none', !visible);
              button.setAttribute('aria-hidden', String(!visible));
              button.tabIndex = visible ? 0 : -1;
            };

            const isLongArticle = () => articleContent.scrollHeight > window.innerHeight * 1.5;
            const shouldShow = () => isLongArticle() && window.scrollY > Math.max(360, window.innerHeight * 0.6);

            let ticking = false;
            const updateVisibility = () => {
              setVisible(shouldShow());
              ticking = false;
            };

            const requestUpdate = () => {
              if (ticking) return;
              ticking = true;
              window.requestAnimationFrame(updateVisibility);
            };

            button.addEventListener('click', () => {
              window.scrollTo({ top: 0, behavior: 'smooth' });
            });

            window.addEventListener('scroll', requestUpdate, { passive: true });
            window.addEventListener('resize', requestUpdate);
            requestUpdate();
          };

          const initPostPageEnhancements = () => {
            initCollapsibleCode();
            initBackToTop();
          };

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initPostPageEnhancements, { once: true });
          } else {
            initPostPageEnhancements();
          }
        </script>

        <!-- Comments -->
        <div class="mt-16">
          <Comments />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
