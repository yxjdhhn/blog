---
import { Image } from 'astro:assets';
import { formatDateShort } from '@/utils/date';
import { getLangFromUrl, getLocalizedUrl, t } from '@/i18n/utils';
import { estimateReadingTime } from '@/i18n/utils';
import type { BlogPost } from '@/utils/posts';
import { getSlug } from '@/utils/posts';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const slug = getSlug(post);
const postUrl = getLocalizedUrl(lang, `/blog/${slug}`);
const readingTime = estimateReadingTime(post.body || '');
const hasHeroImage = Boolean(post.data.heroImage);
---

<article
  class:list={[
    'group overflow-hidden rounded-xl border border-border bg-bg-card transition-colors duration-300 hover:border-primary-border hover:bg-bg-secondary/40',
    hasHeroImage && 'grid grid-cols-[112px_minmax(0,1fr)] items-stretch gap-4 p-4 sm:grid-cols-[136px_minmax(0,1fr)] sm:gap-5',
    !hasHeroImage && 'p-4 sm:p-5',
  ]}
>
  {post.data.heroImage && (
    <a href={postUrl} class="block h-full min-h-24 self-stretch overflow-hidden rounded-lg bg-bg-subtle sm:min-h-28">
      <Image
        src={post.data.heroImage}
        alt={post.data.title}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
        loading="lazy"
        sizes="(min-width: 640px) 136px, 112px"
      />
    </a>
  )}

  <div class="min-w-0">
    <div class="mb-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted">
      <time datetime={post.data.pubDate.toISOString()}>
        {formatDateShort(post.data.pubDate, lang)}
      </time>
      <span>&middot;</span>
      <span>{readingTime} {t(lang, 'post.minRead')}</span>
      {post.data.category && (
        <>
          <span>&middot;</span>
          <a
            href={getLocalizedUrl(lang, `/categories/${post.data.category}/`)}
            class="text-primary hover:underline"
          >
            {post.data.category}
          </a>
        </>
      )}
    </div>

    <h2 class="mb-2 text-base font-semibold leading-snug text-heading transition-colors group-hover:text-primary sm:text-lg">
      <a href={postUrl}>
        {post.data.title}
      </a>
    </h2>

    <p class="mb-3 text-sm leading-6 text-secondary line-clamp-2 sm:line-clamp-3">
      {post.data.description}
    </p>

    {post.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {post.data.tags.map((tag) => (
          <a
            href={getLocalizedUrl(lang, `/tags/${tag}/`)}
            class="rounded-full bg-bg-subtle px-2 py-0.5 text-[11px] text-secondary transition-colors hover:bg-primary-bg-hover hover:text-primary-hover"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}
  </div>
</article>
