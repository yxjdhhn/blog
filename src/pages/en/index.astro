---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeIntro from '@/components/HomeIntro.astro';
import MonthlyPostList from '@/components/MonthlyPostList.astro';
import { getPostsByLang, groupPostsByMonth } from '@/utils/posts';
import { t } from '@/i18n/utils';
import type { Lang } from '@/i18n/translations';

const lang: Lang = 'en';
const posts = await getPostsByLang(lang);
const groups = groupPostsByMonth(posts);
---

<BaseLayout title={t(lang, 'site.title')} description={t(lang, 'site.description')}>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <HomeIntro
      title="Notes on code, tools, and everyday thinking"
      description=""
    />
    <!-- <HomeIntro
      title="Notes on code, tools, and everyday thinking"
      description="This is where I collect thoughts from software development, technical exploration, and the occasional reflection. Everything is arranged over time, so it reads more like a quiet archive than a feed."
    /> -->
    <MonthlyPostList groups={groups} lang={lang} />
    {posts.length === 0 && (
      <p class="text-center text-muted py-12">
        {t(lang, 'search.noResults')}
      </p>
    )}
  </section>
</BaseLayout>
