---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CategoryCloud from '@/components/CategoryCloud.astro';
import { getAllCategories } from '@/utils/posts';
import { t } from '@/i18n/utils';
import type { Lang } from '@/i18n/translations';

const lang: Lang = 'zh';
const categories = await getAllCategories(lang);
---

<BaseLayout title={`${t(lang, 'category.allCategories')} | ${t(lang, 'site.title')}`} description={t(lang, 'site.description')}>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="text-3xl font-bold text-heading mb-8">
      {t(lang, 'category.allCategories')}
    </h1>
    <CategoryCloud categories={categories} />
  </section>
</BaseLayout>
