---
import ThemeToggle from './ThemeToggle.astro';
import LanguagePicker from './LanguagePicker.astro';
import Search from './Search.astro';
import { getLangFromUrl, t, getLocalizedUrl } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname;
const serviceHubUrl = 'https://www.yyykit.com/';
const moreSitesLabel = t(lang, 'nav.moreSites');

const navItems = [
  { label: t(lang, 'nav.home'), href: getLocalizedUrl(lang, '/') },
  { label: t(lang, 'nav.categories'), href: getLocalizedUrl(lang, '/categories/') },
  { label: t(lang, 'nav.about'), href: getLocalizedUrl(lang, '/about') },
];

function isActive(href: string): boolean {
  if (href.endsWith('/') && href.length > 4) {
    return currentPath.startsWith(href);
  }
  return currentPath === href || currentPath === href + '/';
}
---

<header class="site-header sticky top-0 z-50 border-b border-border/80 bg-bg/72 backdrop-blur-xl">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="site-header__bar">
      <a
        href={getLocalizedUrl(lang, '/')}
        class="site-header__brand group flex min-w-0 shrink flex-col leading-none"
      >
        <span class="site-header__brand-mark text-[0.62rem] uppercase tracking-[0.32em] text-muted transition-colors group-hover:text-primary">
          Personal Archive
        </span>
        <span class="site-header__brand-title mt-2 font-[var(--font-serif)] text-[1.45rem] tracking-[-0.04em] text-heading transition-colors group-hover:text-primary sm:text-[1.55rem]">
          {t(lang, 'site.title')}
        </span>
      </a>

      <nav class="site-header__desktop-nav hidden items-center gap-1 rounded-full border border-border/80 bg-bg-card/70 p-1 shadow-[0_18px_40px_color-mix(in_srgb,var(--color-bg)_68%,transparent)] backdrop-blur-xl md:flex">
        {navItems.map(({ label, href }) => (
          <a
            href={href}
            class:list={[
              'rounded-full px-4 py-2 text-sm font-medium transition-colors',
              isActive(href)
                ? 'bg-primary-bg text-heading shadow-[inset_0_1px_0_color-mix(in_srgb,white_18%,transparent)]'
                : 'text-secondary hover:bg-bg-subtle hover:text-heading',
            ]}
          >
            {label}
          </a>
        ))}
      </nav>

      <div class="site-header__controls">
        <a
          href={serviceHubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="site-header__hub control-button control-button--icon group relative"
          aria-label={moreSitesLabel}
        >
          <svg class="relative h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="6" cy="6" r="1.7" />
            <circle cx="12" cy="6" r="1.7" />
            <circle cx="18" cy="6" r="1.7" />
            <circle cx="6" cy="12" r="1.7" />
            <circle cx="12" cy="12" r="1.7" />
            <circle cx="18" cy="12" r="1.7" />
            <circle cx="6" cy="18" r="1.7" />
            <circle cx="12" cy="18" r="1.7" />
            <circle cx="18" cy="18" r="1.7" />
          </svg>
          <span
            class="pointer-events-none absolute left-1/2 top-[calc(100%+0.6rem)] z-20 -translate-x-1/2 translate-y-1 whitespace-nowrap rounded-full border border-border-strong bg-bg-card px-2.5 py-1.5 text-xs font-medium text-heading opacity-0 shadow-lg transition-all duration-150 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100"
            aria-hidden="true"
          >
            {moreSitesLabel}
          </span>
        </a>
        <Search />
        <LanguagePicker />
        <ThemeToggle />

        <button
          id="mobile-menu-btn"
          type="button"
          class="control-button control-button--icon md:hidden"
          aria-label="Toggle menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            <path id="menu-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <nav id="mobile-menu" class="hidden space-y-2 pb-4 md:hidden" aria-hidden="true">
      {navItems.map(({ label, href }) => (
        <a
          href={href}
          class:list={[
            'block rounded-2xl border border-border/80 px-4 py-3 text-sm font-medium transition-colors',
            isActive(href)
              ? 'bg-primary-bg text-heading'
              : 'bg-bg-card/60 text-secondary hover:bg-bg-subtle hover:text-heading',
          ]}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const openIcon = document.getElementById('menu-open');
    const closeIcon = document.getElementById('menu-close');
    if (!btn || !menu || !openIcon || !closeIcon) return;

    if (btn.dataset.mobileMenuBound === 'true') return;
    btn.dataset.mobileMenuBound = 'true';

    btn.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      menu.classList.toggle('hidden', !isHidden);
      menu.setAttribute('aria-hidden', String(!isHidden));
      btn.setAttribute('aria-expanded', String(isHidden));
      openIcon.classList.toggle('hidden', isHidden);
      closeIcon.classList.toggle('hidden', !isHidden);
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>

<style>
  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 5rem;
    padding-block: 0.75rem;
  }

  .site-header__controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  @media (max-width: 720px) {
    .site-header__bar {
      gap: 0.75rem;
      min-height: auto;
      padding-block: 0.65rem;
    }

    .site-header__brand {
      flex: 1 1 auto;
      min-width: 0;
    }

    .site-header__brand-mark {
      font-size: 0.57rem;
      letter-spacing: 0.26em;
    }

    .site-header__brand-title {
      margin-top: 0.45rem;
      font-size: 1.25rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .site-header__controls {
      gap: 0.38rem;
    }

    .site-header__hub {
      display: none;
    }
  }

  @media (min-width: 768px) {
    #mobile-menu-btn,
    #mobile-menu {
      display: none !important;
    }
  }
</style>
