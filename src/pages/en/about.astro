---
import AboutHero from '@/components/AboutHero.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactLinks from '@/components/ContactLinks.astro';
import { t } from '@/i18n/utils';
import type { Lang } from '@/i18n/translations';

const lang: Lang = 'en';
const heroTags = ['Frontend', 'Side Projects', 'Writing'];
---

<BaseLayout title={`${t(lang, 'about.title')} | ${t(lang, 'site.title')}`} description={t(lang, 'site.description')}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <AboutHero
      title={t(lang, 'about.title')}
      description="Frontend developer, side-project tinkerer, and someone who likes turning ideas into clearer words, interfaces, and small digital spaces."
      initials="YY"
      eyebrow="Personal Space"
      tags={heroTags}
    >
      <ContactLinks />
    </AboutHero>

    <div class="space-y-10 border-t border-border pt-10">
      <section class="space-y-3 text-[15px] leading-7 text-secondary sm:text-base">
        <h2 class="text-lg font-semibold tracking-tight text-heading sm:text-xl">
          {t(lang, 'about.sectionWho')}
        </h2>
        <p>Hello! I’m a developer who enjoys writing code and occasionally writing blog posts. Here, I share what I’ve learned from software development, technical exploration, and everyday thinking.</p>
        <p class="text-sm italic leading-6 text-muted sm:text-[15px]">I believe writing things down makes the world a little clearer.</p>
      </section>

      <section class="space-y-3 border-t border-border pt-10 text-[15px] leading-7 text-secondary sm:text-base">
        <h2 class="text-lg font-semibold tracking-tight text-heading sm:text-xl">
          {t(lang, 'about.sectionWhat')}
        </h2>
        <p>Most of my day-to-day work is in frontend development, with a strong focus on usability, interaction, and maintainable code.</p>
        <p>Outside work, I build small tools and side projects to test ideas quickly and keep my curiosity active.</p>
      </section>

      <section class="rounded-2xl bg-bg-secondary/70 px-6 py-6 text-[15px] leading-7 text-secondary sm:text-base">
        <p class="mb-3 text-sm font-medium uppercase tracking-[0.18em] text-muted">
          {t(lang, 'about.sectionBeyond')} · {t(lang, 'about.sectionCurrently')}
        </p>
        <h2 class="text-lg font-semibold tracking-tight text-heading sm:text-xl">
          Keeping room for curiosity
        </h2>
        <div class="mt-4 space-y-3">
        <p>Away from the screen, I read, listen to podcasts, walk, and occasionally travel or take photos.</p>
          <p>Those slower moments help me reset my pace and keep my perspective open.</p>
          <p>Lately I’ve also been exploring AI, Vibe Coding, and more natural ways people and tools can work together while shaping this blog into a space that can keep evolving.</p>
        </div>
      </section>
    </div>
  </article>
</BaseLayout>
