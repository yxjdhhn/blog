---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MonthlyPostList from '@/components/MonthlyPostList.astro';
import { getAllTags, getPostsByTag, groupPostsByMonth } from '@/utils/posts';
import { t } from '@/i18n/utils';
import type { Lang } from '@/i18n/translations';

const lang: Lang = 'en';

export async function getStaticPaths() {
  const tags = await getAllTags('en');
  return [...tags.keys()].map((tag) => ({
    params: { tag },
  }));
}

const { tag } = Astro.params;
const posts = await getPostsByTag(lang, tag!);
const groups = groupPostsByMonth(posts);
---

<BaseLayout title={`${t(lang, 'tag.postsTagged')} "${tag}" | ${t(lang, 'site.title')}`} description={`${t(lang, 'tag.postsTagged')} ${tag}`}>
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-8">
      <a href={`/${lang}/tags/`} class="text-sm text-primary hover:underline">
        &larr; {t(lang, 'tag.allTags')}
      </a>
      <h1 class="text-3xl font-bold text-heading mt-2">
        #{tag}
      </h1>
      <p class="text-muted mt-1">
        {posts.length} {t(lang, 'tag.postsTagged')}
      </p>
    </div>
    <MonthlyPostList groups={groups} lang={lang} />
  </section>
</BaseLayout>
