---
const githubUrl = 'https://github.com/yxjdhhn';
const githubLabel = '@yxjdhhn';
const emailAddress = 'yyykit2635@163.com';
---

<div class="not-prose flex flex-wrap gap-3">
  <a
    href={githubUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="group inline-flex items-center gap-2 rounded-full border border-border/80 px-3.5 py-2 text-sm font-medium text-secondary transition-colors duration-300 hover:border-primary-border hover:text-primary"
    aria-label={`GitHub ${githubLabel}`}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="h-[18px] w-[18px] text-heading transition-colors group-hover:text-primary"
      aria-hidden="true"
    >
      <path d="M12 .5C5.649.5.5 5.8.5 12.34c0 5.235 3.292 9.676 7.86 11.244.574.108.784-.255.784-.566 0-.279-.01-1.02-.016-2.003-3.197.711-3.873-1.59-3.873-1.59-.523-1.37-1.277-1.735-1.277-1.735-1.043-.731.079-.716.079-.716 1.153.084 1.76 1.218 1.76 1.218 1.025 1.807 2.69 1.285 3.345.983.104-.764.401-1.286.73-1.582-2.552-.298-5.236-1.313-5.236-5.845 0-1.291.447-2.347 1.18-3.174-.119-.298-.512-1.5.112-3.127 0 0 .964-.316 3.16 1.212a10.73 10.73 0 0 1 5.754 0c2.194-1.528 3.157-1.212 3.157-1.212.626 1.627.233 2.829.114 3.127.735.827 1.178 1.883 1.178 3.174 0 4.543-2.688 5.543-5.248 5.835.412.364.779 1.083.779 2.183 0 1.577-.014 2.848-.014 3.234 0 .314.207.68.79.564 4.563-1.57 7.852-6.01 7.852-11.242C23.5 5.8 18.351.5 12 .5Z" />
    </svg>
    <span>GitHub</span>
  </a>

  <a
    href={`mailto:${emailAddress}`}
    class="group inline-flex items-center gap-2 rounded-full border border-border/80 px-3.5 py-2 text-sm font-medium text-secondary transition-colors duration-300 hover:border-primary-border hover:text-primary"
    aria-label={`Email ${emailAddress}`}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="h-[18px] w-[18px] text-heading transition-colors group-hover:text-primary"
      aria-hidden="true"
    >
      <rect x="3" y="5" width="18" height="14" rx="2" />
      <path d="m4 7 8 6 8-6" />
    </svg>
    <span>Email</span>
  </a>
</div>
