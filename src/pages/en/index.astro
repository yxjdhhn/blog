---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HomeIntro from '@/components/HomeIntro.astro';
import MonthlyPostList from '@/components/MonthlyPostList.astro';
import { getPostsByLang, groupPostsByMonth } from '@/utils/posts';
import { getLocalizedUrl, t } from '@/i18n/utils';
import type { Lang } from '@/i18n/translations';
import { formatMonthYear } from '@/utils/date';

const lang: Lang = 'en';
const posts = await getPostsByLang(lang);
const groups = groupPostsByMonth(posts);
const latestMonth = posts[0] ? formatMonthYear(posts[0].data.pubDate, lang) : '';
---

<BaseLayout title={t(lang, 'site.title')} description={t(lang, 'site.description')}>
  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
    <HomeIntro
      eyebrow="Personal Notes / Field Archive"
      title="Notes on code, tools, and the decisions behind everyday work"
      titleLines={['Notes on code, tools, and', 'the decisions behind everyday work']}
      description="Notes on code, tools, and the decisions worth keeping around."
      archiveStamp={latestMonth ? `Updated through ${latestMonth}` : undefined}
      links={[
        { label: 'Browse all categories', href: getLocalizedUrl(lang, '/categories/') },
        { label: 'About the author', href: getLocalizedUrl(lang, '/about') },
      ]}
    />
    <MonthlyPostList groups={groups} lang={lang} />
    {posts.length === 0 && (
      <p class="py-12 text-center text-muted">
        {t(lang, 'search.noResults')}
      </p>
    )}
  </section>
</BaseLayout>
