---
import BaseLayout from '@/layouts/BaseLayout.astro';
import MonthlyPostList from '@/components/MonthlyPostList.astro';
import { getAllCategories, getPostsByCategory, groupPostsByMonth } from '@/utils/posts';
import { t } from '@/i18n/utils';
import type { Lang } from '@/i18n/translations';

const lang: Lang = 'en';

export async function getStaticPaths() {
  const categories = await getAllCategories('en');
  return [...categories.keys()].map((category) => ({
    params: { category },
  }));
}

const { category } = Astro.params;
const posts = await getPostsByCategory(lang, category!);
const groups = groupPostsByMonth(posts);
---

<BaseLayout title={`${t(lang, 'category.postsIn')} "${category}" | ${t(lang, 'site.title')}`} description={`${t(lang, 'category.postsIn')} ${category}`}>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-heading">
        {category}
      </h1>
      <p class="text-muted mt-1">
        {posts.length} {t(lang, 'category.postsIn')}
      </p>
    </div>
    <MonthlyPostList groups={groups} lang={lang} />
  </section>
</BaseLayout>
