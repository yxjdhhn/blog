---
import CompactPostListItem from '@/components/CompactPostListItem.astro';
import { formatMonthYear } from '@/utils/date';
import type { Lang } from '@/i18n/translations';
import type { PostsByMonthGroup } from '@/utils/posts';

interface Props {
  groups: PostsByMonthGroup[];
  lang: Lang;
}

const { groups, lang } = Astro.props;
---

<div class="archive-list">
  {groups.map((group) => (
    <section class="archive-group">
      <div class="archive-group__meta">
        <p class="archive-group__count">
          {lang === 'zh' ? `${group.posts.length} 篇` : `${group.posts.length} posts`}
        </p>
        <h2 class="archive-group__title">
          {formatMonthYear(group.date, lang)}
        </h2>
      </div>

      <div class="archive-group__items">
        {group.posts.map((post) => (
          <CompactPostListItem post={post} />
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .archive-list {
    display: grid;
    gap: 3rem;
  }

  .archive-group {
    display: grid;
    gap: 1.2rem;
    padding-top: 1.4rem;
    border-top: 1px solid color-mix(in srgb, var(--color-border) 88%, transparent);
  }

  .archive-group__meta {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .archive-group__count {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .archive-group__title {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.45rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  .archive-group__items {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 960px) {
    .archive-group {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: 1.6rem;
      align-items: start;
    }

    .archive-group__meta {
      position: sticky;
      top: 5.8rem;
    }
  }
</style>
